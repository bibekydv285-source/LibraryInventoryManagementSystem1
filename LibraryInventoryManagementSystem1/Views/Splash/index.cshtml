@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="3;url=@Url.Action("Login", "Auth")" />
    <title>Library Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            html, body {
                height: 100%;
                overflow: hidden;
                background: linear-gradient(135deg, #0b1730 0%, #16244a 60%, #1c2f5e 100%);
                font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            }

            .splash {
                animation: fadeOut 0.8s ease-in 2.4s forwards;
            }

            .logo-badge {
                width: 110px;
                height: 110px;
                border-radius: 24px;
                background: linear-gradient(135deg, #4f6bff 0%, #7b5cff 100%);
                box-shadow: 0 10px 40px rgba(79, 107, 255, 0.4);
                animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
            }

                .logo-badge svg {
                    width: 56px;
                    height: 56px;
                    fill: white;
                }

            .app-title {
                color: #ffffff;
                font-size: 1.9rem;
                font-weight: 700;
                letter-spacing: 0.5px;
                opacity: 0;
                animation: slideUp 0.6s ease-out 0.35s forwards;
            }

            .app-subtitle {
                color: #8fa2d6;
                font-size: 0.95rem;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                opacity: 0;
                animation: slideUp 0.6s ease-out 0.5s forwards;
            }

            .loading-bar {
                width: 160px;
                height: 3px;
                background: rgba(255, 255, 255, 0.15);
                border-radius: 3px;
                overflow: hidden;
                opacity: 0;
                animation: slideUp 0.6s ease-out 0.65s forwards;
            }

                .loading-bar::after {
                    content: "";
                    display: block;
                    height: 100%;
                    width: 40%;
                    background: linear-gradient(90deg, #4f6bff, #7b5cff);
                    border-radius: 3px;
                    animation: loadingSlide 1.4s ease-in-out infinite;
                }

            @@keyframes popIn {
                from {
                    transform: scale(0.6);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            @@keyframes slideUp {
                from {
                    transform: translateY(12px);
                    opacity: 0;
                }

                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            @@keyframes loadingSlide {
                0% {
                    transform: translateX(-100%);
                }

                100% {
                    transform: translateX(350%);
                }
            }

            @@keyframes fadeOut {
                from {
                    opacity: 1;
                }

                to {
                    opacity: 0;
                }
            }
    </style>
</head>
<body>
    <div class="splash d-flex flex-column align-items-center justify-content-center vh-100 w-100">
        <div class="logo-badge d-flex align-items-center justify-content-center mb-4">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4c0-.55.45-1 1-1h5c.9 0 1.7.4 2 1 .3-.6 1.1-1 2-1h5c.55 0 1 .45 1 1v13.5c0 .55-.45 1-1 1h-5.2c-.5 0-.9.2-1.2.5l-.6.6c-.2.2-.6.2-.8 0l-.6-.6c-.3-.3-.7-.5-1.2-.5H5c-.55 0-1-.45-1-1V4z" />
            </svg>
        </div>
        <h1 class="app-title text-center mb-0">Library Inventory<br />Management System</h1>
        <p class="app-subtitle text-center mt-2 mb-0">Loading your library</p>
        <div class="loading-bar mt-4"></div>
    </div>
</body>
</html>
