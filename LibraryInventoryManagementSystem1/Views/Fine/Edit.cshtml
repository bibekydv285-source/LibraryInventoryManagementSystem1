@model LibraryInventoryManagementSystem1.Models.Fine

@{
    ViewData["Title"] = "Edit Fine";
    Layout = "_AdminLayout";
}

<div class="dashboard-hero" style="margin-bottom:20px;">
    <h2>Edit Fine</h2>
</div>

<a href="@Url.Action("Index")" style="display:inline-block; margin-bottom:15px;">Back to Pending Fines</a>

@if (TempData["Error"] != null)
{
    <div style="color:#b00020; margin-bottom:10px;">@TempData["Error"]</div>
}

<div style="max-width:500px; border:1px solid #ccc; padding:15px;">
    <div style="margin-bottom:10px;">
        <strong>Fine Id:</strong> @Model.FineId<br />
        <strong>Book:</strong> @(Model.BookIssue?.Book?.Title ?? "N/A")<br />
        <strong>Student:</strong> @(Model.BookIssue?.Student?.Name ?? "N/A")<br />
        <strong>Status:</strong> @Model.PaymentStatus
    </div>

    <form method="post" asp-action="Edit" asp-route-id="@Model.FineId">
        @Html.AntiForgeryToken()
        <label for="amount"><strong>Fine Amount (Rs.)</strong></label><br />
        <input type="number" step="0.01" min="0.01" name="amount" id="amount"
               value="@Model.Amount" required style="padding:8px; width:200px; margin:8px 0; border:1px solid #ccc;" />
        <br />
        <button type="submit" style="padding:8px 16px; background:#2e7d32; color:#fff; border:none; border-radius:4px; cursor:pointer; margin-top:10px;">
            Save Changes
        </button>
        <a href="@Url.Action("Index")" style="margin-left:10px;">Cancel</a>
    </form>
</div>