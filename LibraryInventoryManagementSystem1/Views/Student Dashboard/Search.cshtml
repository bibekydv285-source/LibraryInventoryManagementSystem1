@model LibraryInventoryManagementSystem1.Dto.BookSearchDto
@{
    ViewData["Title"] = "Search Books";
    Layout = "_StudentLayout";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#166534;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; color:#b91c1c;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="dashboard-section">
    <h3 style="margin-bottom:15px;">Search Books</h3>

    <form asp-action="Search" method="get" style="display:flex; gap:10px; margin-bottom:20px; flex-wrap:wrap;">
        <input type="text" name="query" value="@Model.Query" placeholder="Title, author, or ISBN..."
               style="flex:1; min-width:220px; padding:10px;" />
        <select name="category" style="padding:10px;">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(c == Model.Category)">@c</option>
            }
        </select>
        <button type="submit" class="btn-primary" style="padding:10px 20px;">Search</button>
    </form>

    <table class="table" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Availability</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Any())
            {
                foreach (var book in Model.Results)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Category</td>
                        <td>
                            @if (book.AvailableQty > 0)
                            {
                                <span style="color:#27ae60;">Available (@book.AvailableQty)</span>
                            }
                            else
                            {
                                <span style="color:#c0392b;">Not Available</span>
                            }
                        </td>
                        <td>
                            @if (book.AvailableQty > 0)
                            {
                                <form asp-controller="Student" asp-action="BorrowBook" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <button type="submit" class="btn-secondary" style="padding:6px 12px;">Borrow</button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Student" asp-action="Reserve" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <button type="submit" class="btn-secondary" style="padding:6px 12px;">Reserve</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5">No books matched your search.</td></tr>
            }
        </tbody>
    </table>
</div>