@using LibraryInventoryManagementSystem1.Models
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_StudentLayout";
    var issuedBooks = (List<BookIssue>)ViewBag.IssuedBooks;
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#166534;">
        @TempData["SuccessMessage"]
    </div>
}

<div class="dashboard-hero" style="margin-bottom:20px;">
    <h2>Welcome back, @ViewBag.StudentName! 👋</h2>
    <p>Here's what you've currently got checked out.</p>
</div>

<div class="dashboard-stats" style="display:flex; gap:20px; margin-bottom:30px;">
    <div class="stat-card">
        <div class="stat-label">Books Issued</div>
        <div class="stat-value">@ViewBag.IssuedCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pending Fines</div>
        <div class="stat-value">@(((decimal)ViewBag.PendingFineTotal).ToString("C"))</div>
    </div>
</div>

<div class="dashboard-section">
    <h3 style="margin-bottom:15px;">Currently Issued Books</h3>

    <table class="table" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (issuedBooks != null && issuedBooks.Any())
            {
                foreach (var issue in issuedBooks)
                {
                    bool isOverdue = issue.DueDate < DateTime.Now;
                    <tr>
                        <td>@issue.Book!.Title</td>
                        <td>@issue.Book!.Author</td>
                        <td>@issue.IssueDate.ToString("dd-MMM-yyyy")</td>
                        <td>@issue.DueDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @if (isOverdue)
                            {
                                <span style="color:#c0392b; font-weight:600;">Overdue</span>
                            }
                            else
                            {
                                <span style="color:#27ae60;">On time</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5">You have no books currently issued.</td></tr>
            }
        </tbody>
    </table>
</div>