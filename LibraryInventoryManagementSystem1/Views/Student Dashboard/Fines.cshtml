@using LibraryInventoryManagementSystem1.Models
@model List<Fine>

@{
    ViewData["Title"] = "My Fines";
    Layout = "_StudentLayout";
    decimal pendingTotal = Model != null
        ? Model.Where(f => f.PaymentStatus == "Pending").Sum(f => f.Amount)
        : 0;
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#166534;">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; color:#b91c1c;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="dashboard-stats" style="display:flex; gap:20px; margin-bottom:30px;">
    <div class="stat-card">
        <div class="stat-label">Pending Fines</div>
        <div class="stat-value">@pendingTotal.ToString("C")</div>
    </div>
</div>

<div class="dashboard-section">
    <h3 style="margin-bottom:15px;">My Fines</h3>

    <table class="table" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th>Book</th>
                <th>Amount</th>
                <th>Status</th>
                <!-- New: student can pay a pending fine directly from here -->
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var fine in Model)
                {
                    bool isPending = fine.PaymentStatus == "Pending";
                    <tr>
                        <td>@fine.BookIssue?.Book?.Title</td>
                        <td>@fine.Amount.ToString("C")</td>
                        <td>
                            @if (isPending)
                            {
                                <span style="color:#c0392b; font-weight:600;">Pending</span>
                            }
                            else
                            {
                                <span style="color:#27ae60;">Paid</span>
                            }
                        </td>
                        <td>
                            @if (isPending)
                            {
                                <!-- Posts to StudentController.PayFine(fineId) for this specific row -->
                                <form asp-controller="Student" asp-action="PayFine" method="post"
                                      onsubmit="return confirm('Pay @fine.Amount.ToString("C") for \'@fine.BookIssue?.Book?.Title\'?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fineId" value="@fine.FineId" />
                                    <button type="submit"
                                            style="padding:0.45rem 1rem; background-color:#4f5fe0; color:white; border:none; border-radius:6px; font-size:0.85rem; cursor:pointer;">
                                        Pay Now
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4">You have no fines.</td></tr>
            }
        </tbody>
    </table>
</div>
