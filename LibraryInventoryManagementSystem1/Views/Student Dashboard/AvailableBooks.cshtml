@model List<LibraryInventoryManagementSystem1.Models.Book>
@{
    ViewData["Title"] = "Available Books";
    Layout = "_StudentLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#166534;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#fef2f2; border:1px solid #fecaca; border-radius:8px; color:#b91c1c;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="dashboard-section">
    <h3 style="margin-bottom:15px;">Available Books</h3>

    <table class="table" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Category</td>
                        <td>@book.AvailableQty</td>
                        <td><span style="color:#27ae60;">Available</span></td>
                        <td>
                            <form asp-controller="Student" asp-action="BorrowBook" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookId" value="@book.BookId" />
                                <button type="submit" class="btn-secondary" style="padding:6px 12px;">Borrow</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">No books are currently available.</td></tr>
            }
        </tbody>
    </table>
</div>