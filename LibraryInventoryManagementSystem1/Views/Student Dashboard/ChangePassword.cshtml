@using LibraryInventoryManagementSystem1.Dto
@model ChangePasswordDto

@{
    ViewData["Title"] = "Change Password";
    Layout = "_StudentLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#166534;">
        @TempData["SuccessMessage"]
    </div>
}

<div class="dashboard-hero" style="margin-bottom:20px;">
    <h2>Update Your Password 🔑</h2>
    <p>Choose a new password to keep your account secure.</p>
</div>

<div class="dashboard-section" style="max-width:520px;">
    <h3 style="margin-bottom:15px;">Change Password</h3>

    <form asp-controller="Student" asp-action="ChangePassword" method="post">

        <div style="margin-bottom:18px;">
            <label asp-for="CurrentPassword" style="display:block; font-weight:600; margin-bottom:6px;">Current Password</label>
            <input asp-for="CurrentPassword" type="password"
                   placeholder="Enter your current password"
                   style="width:100%; padding:0.7rem; border-radius:8px; border:1px solid #ccc; box-sizing:border-box; font-size:0.95rem;" />
            <span asp-validation-for="CurrentPassword" style="color:#c0392b; font-size:0.85rem;"></span>
        </div>

        <div style="margin-bottom:18px;">
            <label asp-for="NewPassword" style="display:block; font-weight:600; margin-bottom:6px;">New Password</label>
            <input asp-for="NewPassword" type="password"
                   placeholder="Enter a new password"
                   style="width:100%; padding:0.7rem; border-radius:8px; border:1px solid #ccc; box-sizing:border-box; font-size:0.95rem;" />
            <span asp-validation-for="NewPassword" style="color:#c0392b; font-size:0.85rem;"></span>
        </div>

        <div style="margin-bottom:24px;">
            <label asp-for="ConfirmPassword" style="display:block; font-weight:600; margin-bottom:6px;">Confirm New Password</label>
            <input asp-for="ConfirmPassword" type="password"
                   placeholder="Re-enter the new password"
                   style="width:100%; padding:0.7rem; border-radius:8px; border:1px solid #ccc; box-sizing:border-box; font-size:0.95rem;" />
            <span asp-validation-for="ConfirmPassword" style="color:#c0392b; font-size:0.85rem;"></span>
        </div>

        <button type="submit"
                style="padding:0.75rem 1.6rem; background-color:#4f5fe0; color:white; border:none; border-radius:8px; font-size:1rem; cursor:pointer;">
            Update Password
        </button>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
