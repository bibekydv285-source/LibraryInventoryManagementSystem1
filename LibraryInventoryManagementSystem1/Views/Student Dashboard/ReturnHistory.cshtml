@model List<LibraryInventoryManagementSystem1.Models.BookIssue>
@{
    ViewData["Title"] = "My Book Returns";
    Layout = "_StudentLayout";
}

<div class="dashboard-section">
    <h3 style="margin-bottom:15px;">My Book Returns</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Due Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var issue in Model)
                {
                    <tr>
                        <td>@issue.Book!.Title</td>
                        <td>@issue.Book!.Author</td>
                        <td>@issue.DueDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @if (issue.Status == "Returned")
                            {
                                <span style="color:#27ae60;">Returned</span>
                            }
                            else if (issue.Status == "Overdue")
                            {
                                <span style="color:#c0392b;">Overdue</span>
                            }
                            else
                            {
                                <span style="color:#e67e22;">Issued</span>
                            }
                        </td>
                        <td>
                            @if (issue.Status != "Returned")
                            {
                                <form asp-controller="Student" asp-action="ReturnBook" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="issueId" value="@issue.IssueId" />
                                    <button type="submit" class="btn-secondary" style="padding:6px 12px;">Return Book</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5">You haven't borrowed any books yet.</td></tr>
            }
        </tbody>
    </table>
</div>