@model List<LibraryInventoryManagementSystem1.Models.Reservation>
@{
    ViewData["Title"] = "My Reservations";
    Layout = "_StudentLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-bottom:20px; padding:12px 16px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; color:#166534;">
        @TempData["SuccessMessage"]
    </div>
}

<div class="dashboard-section" style="margin-bottom:25px; padding:20px; background:#f8f9fc; border:1px solid #e4e6f5; border-radius:10px;">
    <h3 style="margin-bottom:12px;">Reserve a Book</h3>
    <p style="margin-bottom:15px; color:#666;">
        Pick a book below to reserve it. You can also reserve directly from the
        <a asp-action="Search">Search</a> page.
    </p>

    <form asp-action="Reserve" method="post" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        @Html.AntiForgeryToken()
        <select name="bookId" required style="flex:1; min-width:250px; padding:8px 12px; border:1px solid #ccc; border-radius:6px;">
            <option value="" disabled selected>-- Select a book --</option>
            @foreach (var book in (List<LibraryInventoryManagementSystem1.Models.Book>)ViewBag.AllBooks)
            {
                var availabilityLabel = book.AvailableQty > 0
                    ? $"{book.Title} (Available)"
                    : $"{book.Title} (Unavailable)";
                <option value="@book.BookId">@availabilityLabel</option>
            }
        </select>
        <button type="submit" class="btn-primary" style="padding:8px 18px;">Reserve</button>
    </form>
</div>

<div class="dashboard-section">
    <h3 style="margin-bottom:15px;">My Reservations</h3>

    <table class="table" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th>Title</th>
                <th>Reserved On</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Book!.Title</td>
                        <td>@r.ReservedDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @{
                                var color = r.Status switch
                                {
                                    "Approved" => "#27ae60",
                                    "Cancelled" => "#999",
                                    "Fulfilled" => "#2563eb",
                                    _ => "#e67e22" // Pending
                                };
                            }
                            <span style="color:@color; font-weight:600;">@r.Status</span>
                        </td>
                        <td>
                            @if (r.Status == "Pending")
                            {
                                <form asp-action="CancelReservation" method="post" style="display:inline;"
                                      onsubmit="return confirm('Cancel this reservation?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn-secondary" style="padding:6px 12px;">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4">You have no reservations.</td></tr>
            }
        </tbody>
    </table>
</div>