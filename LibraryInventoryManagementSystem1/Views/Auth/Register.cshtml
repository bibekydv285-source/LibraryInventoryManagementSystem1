@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
                margin: 0;
                background-color: #f3f4f6;
                font-family: 'Segoe UI', sans-serif;
            }

            .register-container {
                background: #fff;
                padding: 2.5rem;
                border-radius: 12px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.08);
                width: 380px;
            }

                .register-container h1 {
                    font-size: 2rem;
                }

                .register-container .form-control {
                    border-radius: 8px;
                    padding: 0.7rem;
                    font-size: 0.95rem;
                }

            .btn-register {
                background-color: #4f5fe0;
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: 0.75rem;
                font-size: 1rem;
            }

                .btn-register:hover {
                    background-color: #3f4fd0;
                    color: #fff;
                }

            .student-option {
                background: #f0fdf4;
                border: 1px solid #bbf7d0;
                border-radius: 8px;
                font-size: 0.9rem;
            }

                .student-option a {
                    color: #166534;
                    font-weight: 700;
                    text-decoration: underline;
                }

            .error-message {
                color: #e04f4f;
            }
    </style>
</head>
<body>
    <div class="register-container">
        <h1 class="text-center mb-4">Register</h1>

        <div class="student-option text-center p-3 mb-3">
            Are you a student? <a asp-controller="Student" asp-action="Add">Register here</a> to create your student account and library access.
        </div>

        <div class="d-flex align-items-center text-center text-muted my-3" style="font-size:0.85rem;">
            <hr class="flex-grow-1" />
            <span class="mx-3">Or create a staff account</span>
            <hr class="flex-grow-1" />
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="error-message text-center mb-3">@ViewBag.ErrorMessage</div>
        }

        <form asp-controller="Auth" asp-action="RegisterUser" method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="Email" placeholder="Enter your email" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" name="Password" placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn btn-register w-100">Submit</button>
        </form>

        <div class="text-center mt-3" style="font-size:0.9rem;">
            Already Registered User? Login
            <a asp-controller="Auth" asp-action="Login">Here</a>
        </div>
    </div>
</body>
</html>
