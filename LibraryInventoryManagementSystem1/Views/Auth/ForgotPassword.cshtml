@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4">Forgot Password</h3>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <label class="form-label">Enter your registered email</label>
                    <input type="email" class="form-control" name="email" placeholder="Enter your email" required>
                </div>

                <button type="submit" class="btn btn-primary w-100">Get Reset Code</button>
            </form>

            <p class="text-center mt-3 mb-0">
                <a asp-controller="Auth" asp-action="Login">Back to Login</a>
            </p>
        </div>
    </div>
</div>