@model List<LibraryInventoryManagementSystem1.Models.AdminNotification>
@{
    ViewData["Title"] = "Notifications";
    Layout = "_AdminLayout";
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 fw-bold mb-1">All Notifications</h1>
            <p class="text-muted mb-0">Every reservation, issue, return, and fine alert in one place.</p>
        </div>
        <button id="markAllReadBtnPage" class="btn btn-outline-primary btn-sm">Mark all read</button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <div class="fs-1 mb-2">🔔</div>
                    <p class="mb-0">No notifications yet</p>
                </div>
            }
            else
            {
                foreach (var n in Model)
                {
                    var bg = n.IsRead ? "" : "bg-light";
                    var badgeColor = n.Priority switch
                    {
                        "High" => "danger",
                        "Low" => "secondary",
                        _ => "primary"
                    };

                    <div class="px-4 py-3 border-bottom @bg d-flex justify-content-between align-items-start notif-row" data-id="@n.Id">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-semibold">@n.Title</span>
                                <span class="badge bg-@badgeColor bg-opacity-10 text-@badgeColor small">@n.Type</span>
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary rounded-circle" style="width:8px;height:8px;padding:0;"></span>
                                }
                            </div>
                            <div class="text-muted small mb-1">@n.Message</div>
                            <div class="text-muted" style="font-size:0.75rem;">@n.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                        <div class="d-flex gap-2">
                            @if (!n.IsRead)
                            {
                                <button class="btn btn-sm btn-outline-secondary mark-read-btn" data-id="@n.Id">Mark read</button>
                            }
                            <button class="btn btn-sm btn-outline-danger archive-btn" data-id="@n.Id">Archive</button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('markAllReadBtnPage')?.addEventListener('click', async () => {
            await fetch('/Admin/MarkAllNotificationsRead', { method: 'POST' });
            location.reload();
        });

        document.querySelectorAll('.mark-read-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                await fetch('/Admin/MarkNotificationRead?id=' + this.dataset.id, { method: 'POST' });
                location.reload();
            });
        });

        document.querySelectorAll('.archive-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                await fetch('/Admin/ArchiveNotification?id=' + this.dataset.id, { method: 'POST' });
                location.reload();
            });
        });
    </script>
}