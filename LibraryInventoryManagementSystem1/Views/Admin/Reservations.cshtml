@model List<LibraryInventoryManagementSystem1.Models.Reservation>
@{
    ViewData["Title"] = "Reservations";
    Layout = "_AdminLayout";
}

<div>
    <h1 class="h4 fw-bold mb-1">Book Reservations</h1>
    <p class="text-muted mb-4">All reservations made by students, newest first.</p>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <div class="fs-1 mb-2">🔖</div>
                    <p class="mb-0">No reservations yet</p>
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Student</th>
                            <th>Book</th>
                            <th>Reserved On</th>
                            <th>Status</th>
                            <th class="pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var badgeColor = r.Status switch
                            {
                                "Pending" => "warning",
                                "Fulfilled" => "success",
                                "Cancelled" => "secondary",
                                _ => "light"
                            };

                            <tr>
                                <td class="ps-4">@r.Student?.Name</td>
                                <td>@r.Book?.Title</td>
                                <td>@r.ReservedDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="badge bg-@badgeColor bg-opacity-10 text-@badgeColor">@r.Status</span></td>
                                <td class="pe-4">
                                    @if (r.Status == "Pending")
                                    {
                                        <form asp-controller="Admin" asp-action="FulfillReservation" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Mark Fulfilled</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>