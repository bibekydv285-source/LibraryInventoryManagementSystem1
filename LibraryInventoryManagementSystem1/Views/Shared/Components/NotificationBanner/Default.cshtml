@model List<LibraryInventoryManagementSystem1.Models.Notification>

<div class="notif-bell-wrapper" style="position:relative;">
    <button type="button" id="notifBellBtn" aria-label="Notifications"
            style="position:relative; background:transparent; border:none; cursor:pointer; font-size:1.4rem; padding:6px; line-height:1;">
        🔔
        @if (Model != null && Model.Any())
        {
            <span id="notifBellBadge"
                  style="position:absolute; top:0; right:0; background:#dc2626; color:#fff; font-size:.65rem;
                font-weight:700; border-radius:999px; min-width:16px; height:16px; display:flex;
                align-items:center; justify-content:center; padding:0 4px;">
                @(Model.Count > 9 ? "9+" : Model.Count.ToString())
            </span>
        }
    </button>

    <div id="notifBellDropdown"
         style="display:none; position:absolute; top:calc(100% + 8px); right:0; width:340px; max-height:420px;
        overflow-y:auto; background:#fff; border:1px solid #e5e7eb; border-radius:10px;
        box-shadow:0 10px 30px rgba(30,27,58,.15); z-index:1000;">

        <div style="padding:12px 16px; border-bottom:1px solid #e5e7eb; display:flex;
            align-items:center; justify-content:space-between;">
            <span style="font-weight:700; color:#1e1b3a;">Notifications</span>
            @if (Model != null && Model.Any())
            {
                <button type="button" id="notifMarkAllBtn"
                        style="background:transparent; border:none; cursor:pointer; color:#4338ca;
                    font-size:.78rem; font-weight:600; padding:0;">
                    Mark all as read
                </button>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <div id="notifBellList">
                @foreach (var n in Model)
                {
                    var title = string.IsNullOrWhiteSpace(n.Title) ? n.Type : n.Title;
                    <div class="notif-bell-item" data-notif-id="@n.Id"
                         style="padding:10px 16px; border-bottom:1px solid #f3f4f6; cursor:pointer;">
                        <div style="font-weight:600; font-size:.9rem; color:#1e1b3a;">@title</div>
                        <div style="font-size:.82rem; color:#6b7280; margin-top:2px; overflow:hidden;
                            text-overflow:ellipsis; white-space:nowrap;">
                            @n.Message
                        </div>
                        <div style="font-size:.72rem; color:#9ca3af; margin-top:4px;">
                            @n.CreatedDate.ToString("dd-MMM-yyyy HH:mm")
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div id="notifBellEmpty" style="padding:20px 16px; color:#9ca3af; font-size:.88rem; text-align:center;">
                You're all caught up.
            </div>
        }

        <a href="/Student-Dashboard/Notifications"
           style="display:block; text-align:center; padding:10px; font-size:.85rem; font-weight:600;
            color:#4338ca; text-decoration:none; border-top:1px solid #e5e7eb;">
            View all notifications
        </a>
    </div>
</div>

<script>
    (function() {
        const btn = document.getElementById('notifBellBtn');
        const dropdown = document.getElementById('notifBellDropdown');
        if (!btn || !dropdown) return;

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        function updateBadgeAndEmptyState() {
            const badge = document.getElementById('notifBellBadge');
            const remaining = document.querySelectorAll('.notif-bell-item').length;

            if (remaining > 0) {
                if (badge) badge.innerText = remaining > 9 ? '9+' : remaining.toString();
            } else {
                if (badge) badge.remove();

                const markAllBtn = document.getElementById('notifMarkAllBtn');
                if (markAllBtn) markAllBtn.remove();

                if (!document.getElementById('notifBellEmpty')) {
                    const list = document.getElementById('notifBellList');
                    if (list) {
                        list.insertAdjacentHTML('afterend',
                            '<div id="notifBellEmpty" style="padding:20px 16px; color:#9ca3af; font-size:.88rem; text-align:center;">You\'re all caught up.</div>');
                    }
                }
            }
        }

        // Toggle dropdown open/closed on bell click
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
        });

        // Close dropdown when clicking anywhere outside it
        document.addEventListener('click', function(e) {
            if (!dropdown.contains(e.target) && e.target !== btn) {
                dropdown.style.display = 'none';
            }
        });

        // Click a single notification -> mark as read, remove it, update badge
        document.querySelectorAll('.notif-bell-item').forEach(function(item) {
            item.addEventListener('click', function() {
                const id = item.getAttribute('data-notif-id');

                fetch('/Student/MarkNotificationRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getToken()
                    },
                    body: JSON.stringify({ id: parseInt(id) })
                }).then(function() {
                    item.remove();
                    updateBadgeAndEmptyState();
                }).catch(function(err) {
                    console.error('Failed to mark notification as read', err);
                });
            });
        });

        // "Mark all as read" -> clears everything in one call
        const markAllBtn = document.getElementById('notifMarkAllBtn');
        if (markAllBtn) {
            markAllBtn.addEventListener('click', function(e) {
                e.stopPropagation();

                fetch('/Student/MarkAllNotificationsRead', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getToken()
                    }
                }).then(function() {
                    document.querySelectorAll('.notif-bell-item').forEach(el => el.remove());
                    updateBadgeAndEmptyState();
                }).catch(function(err) {
                    console.error('Failed to mark all notifications as read', err);
                });
            });
        }
    })();
</script>