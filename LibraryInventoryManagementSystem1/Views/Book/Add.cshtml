@model LibraryInventoryManagementSystem1.Dto.BookDto

@{
    ViewData["Title"] = "Add New Book";
    Layout = "_AdminLayout";

    var errorMessage = ViewBag.ErrorMessage?.ToString();
}

<style>
    /* =========================================
           ADD BOOK PAGE
           ========================================= */

    .add-book-page {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    /* =========================================
           HERO
           ========================================= */

    .add-book-hero {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 24px;
        box-sizing: border-box;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
    }

        .add-book-hero h2 {
            margin: 0;
            color: #111827;
            font-size: 28px;
            font-weight: 700;
        }

        .add-book-hero p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    /* =========================================
           FORM CARD
           ========================================= */

    .add-book-card {
        width: 100%;
        max-width: 720px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 30px;
        box-sizing: border-box;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
    }

    .add-book-card-header {
        margin-bottom: 25px;
    }

        .add-book-card-header h3 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 700;
        }

        .add-book-card-header p {
            margin: 6px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

    /* =========================================
           ERROR MESSAGE
           ========================================= */

    .add-book-error {
        margin-bottom: 22px;
        padding: 12px 15px;
        border: 1px solid #fecaca;
        border-radius: 9px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 14px;
    }

    /* =========================================
           FORM GROUP
           ========================================= */

    .book-form-group {
        margin-bottom: 20px;
    }

    .book-form-label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
    }

    .required-mark {
        color: #dc2626;
    }

    .book-form-input {
        width: 100%;
        height: 46px;
        padding: 0 14px;
        box-sizing: border-box;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        outline: none;
        background: #ffffff;
        color: #111827;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .book-form-input::placeholder {
            color: #9ca3af;
        }

        .book-form-input:hover {
            border-color: #9ca3af;
        }

        .book-form-input:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }

    .book-form-help {
        display: block;
        margin-top: 6px;
        color: #9ca3af;
        font-size: 12px;
    }

    /* =========================================
           FORM ACTIONS
           ========================================= */

    .book-form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #eef0f3;
    }

    .add-book-btn {
        height: 44px;
        padding: 0 22px;
        border: none;
        border-radius: 9px;
        background: #4f46e5;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .add-book-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

    .cancel-book-btn {
        height: 44px;
        padding: 0 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #ffffff;
        color: #374151;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .cancel-book-btn:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #111827;
        }

    /* =========================================
           VALIDATION
           ========================================= */

    .validation-message {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 768px) {

        .add-book-hero {
            padding: 22px;
        }

            .add-book-hero h2 {
                font-size: 24px;
            }

        .add-book-card {
            padding: 22px;
        }
    }

    @@media (max-width: 480px) {

        .add-book-hero {
            padding: 20px;
        }

            .add-book-hero h2 {
                font-size: 21px;
            }

        .add-book-card {
            padding: 18px;
        }

        .book-form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .add-book-btn,
        .cancel-book-btn {
            width: 100%;
        }
    }
</style>


<div class="add-book-page">

    <!-- =====================================
         PAGE HEADER
         ===================================== -->

    <div class="add-book-hero">

        <h2>
            Add New Book
        </h2>

        <p>
            Add a new book to the library inventory.
        </p>

    </div>


    <!-- =====================================
         FORM CARD
         ===================================== -->

    <div class="add-book-card">

        <div class="add-book-card-header">

            <h3>
                Book Information
            </h3>

            <p>
                Enter the details of the new book below.
            </p>

        </div>


        <!-- Error Message -->
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="add-book-error">
                @errorMessage
            </div>
        }


        <!-- Add Book Form -->

        <form method="post"
              asp-action="Add">

            @Html.AntiForgeryToken()

            <!-- Title -->

            <div class="book-form-group">

                <label for="Title"
                       class="book-form-label">
                    Title <span class="required-mark">*</span>
                </label>

                <input type="text"
                       id="Title"
                       name="Title"
                       class="book-form-input"
                       placeholder="Enter book title"
                       value="@Model?.Title"
                       required />

                <span class="book-form-help">
                    Enter the complete title of the book.
                </span>

            </div>


            <!-- Author -->

            <div class="book-form-group">

                <label for="Author"
                       class="book-form-label">
                    Author <span class="required-mark">*</span>
                </label>

                <input type="text"
                       id="Author"
                       name="Author"
                       class="book-form-input"
                       placeholder="Enter author name"
                       value="@Model?.Author"
                       required />

                <span class="book-form-help">
                    Enter the name of the book's author.
                </span>

            </div>


            <!-- Category -->

            <div class="book-form-group">

                <label for="Category"
                       class="book-form-label">
                    Category
                </label>

                <input type="text"
                       id="Category"
                       name="Category"
                       class="book-form-input"
                       placeholder="e.g. Programming, Science, Fiction"
                       value="@Model?.Category" />

                <span class="book-form-help">
                    Optional. Add a category to make books easier to find.
                </span>

            </div>


            <!-- Total Quantity -->

            <div class="book-form-group">

                <label for="TotalQty"
                       class="book-form-label">
                    Total Quantity <span class="required-mark">*</span>
                </label>

                <input type="number"
                       id="TotalQty"
                       name="TotalQty"
                       class="book-form-input"
                       placeholder="Enter total quantity"
                       value="@Model?.TotalQty"
                       min="1"
                       required />

                <span class="book-form-help">
                    Enter the total number of copies available in the library.
                </span>

            </div>


            <!-- Actions -->

            <div class="book-form-actions">

                <button type="submit"
                        class="add-book-btn">
                    Add Book
                </button>

                <a asp-action="Index"
                   class="cancel-book-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>