@model LibraryInventoryManagementSystem1.Models.Book?

@{
    ViewData["Title"] = "Edit Book";
    Layout = "_AdminLayout";

    var errorMessage = ViewBag.ErrorMessage?.ToString();
    var issuedQuantity = Model != null
        ? Model.TotalQty - Model.AvailableQty
        : 0;
}

<style>
    /* =========================================
           EDIT BOOK PAGE
           ========================================= */

    .edit-book-page {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    /* =========================================
           HERO
           ========================================= */

    .edit-book-hero {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 24px;
        box-sizing: border-box;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
    }

        .edit-book-hero h2 {
            margin: 0;
            color: #111827;
            font-size: 28px;
            font-weight: 700;
        }

        .edit-book-hero p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    /* =========================================
           FORM CARD
           ========================================= */

    .edit-book-card {
        width: 100%;
        max-width: 720px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 30px;
        box-sizing: border-box;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
    }

    .edit-book-card-header {
        margin-bottom: 25px;
    }

        .edit-book-card-header h3 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 700;
        }

        .edit-book-card-header p {
            margin: 6px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

    /* =========================================
           BOOK ID
           ========================================= */

    .edit-book-id {
        display: inline-flex;
        align-items: center;
        margin-top: 12px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        color: #374151;
        font-size: 12px;
        font-weight: 700;
    }

    /* =========================================
           ERROR
           ========================================= */

    .edit-book-error {
        margin-bottom: 22px;
        padding: 12px 15px;
        border: 1px solid #fecaca;
        border-radius: 9px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 14px;
    }

    /* =========================================
           FORM GROUP
           ========================================= */

    .edit-form-group {
        margin-bottom: 20px;
    }

    .edit-form-label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
    }

    .required-mark {
        color: #dc2626;
    }

    .edit-form-input {
        width: 100%;
        height: 46px;
        padding: 0 14px;
        box-sizing: border-box;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        outline: none;
        background: #ffffff;
        color: #111827;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .edit-form-input::placeholder {
            color: #9ca3af;
        }

        .edit-form-input:hover {
            border-color: #9ca3af;
        }

        .edit-form-input:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }

    /* =========================================
           ISSUED INFORMATION
           ========================================= */

    .issued-info {
        margin: 5px 0 22px;
        padding: 13px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 9px;
    }

    .issued-info-label {
        color: #92400e;
        font-size: 13px;
        font-weight: 600;
    }

    .issued-info-value {
        min-width: 32px;
        padding: 5px 10px;
        text-align: center;
        border-radius: 20px;
        background: #fef3c7;
        color: #92400e;
        font-size: 12px;
        font-weight: 700;
    }

    .edit-form-help {
        display: block;
        margin-top: 6px;
        color: #9ca3af;
        font-size: 12px;
    }

    /* =========================================
           FORM ACTIONS
           ========================================= */

    .edit-form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #eef0f3;
    }

    .save-book-btn {
        height: 44px;
        padding: 0 22px;
        border: none;
        border-radius: 9px;
        background: #4f46e5;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .save-book-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

    .cancel-edit-btn {
        height: 44px;
        padding: 0 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #ffffff;
        color: #374151;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .cancel-edit-btn:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #111827;
        }

    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 768px) {

        .edit-book-hero {
            padding: 22px;
        }

            .edit-book-hero h2 {
                font-size: 24px;
            }

        .edit-book-card {
            padding: 22px;
        }
    }

    @@media (max-width: 480px) {

        .edit-book-hero {
            padding: 20px;
        }

            .edit-book-hero h2 {
                font-size: 21px;
            }

        .edit-book-card {
            padding: 18px;
        }

        .edit-form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .save-book-btn,
        .cancel-edit-btn {
            width: 100%;
        }

        .issued-info {
            align-items: flex-start;
        }
    }
</style>


<div class="edit-book-page">

    <!-- =====================================
         PAGE HEADER
         ===================================== -->

    <div class="edit-book-hero">

        <h2>
            Edit Book
        </h2>

        <p>
            Update the information and quantity of this library book.
        </p>

    </div>


    @if (Model != null)
    {
        <!-- =====================================
             EDIT FORM CARD
             ===================================== -->

        <div class="edit-book-card">

            <div class="edit-book-card-header">

                <h3>
                    Book Information
                </h3>

                <p>
                    Update the details below and save your changes.
                </p>

                <span class="edit-book-id">
                    Book ID: #@Model.BookId
                </span>

            </div>


            <!-- Error Message -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="edit-book-error">
                    @errorMessage
                </div>
            }


            <!-- Edit Form -->

            <form method="post"
                  asp-action="Edit"
                  asp-route-id="@Model.BookId">

                @Html.AntiForgeryToken()


                <!-- Title -->

                <div class="edit-form-group">

                    <label for="Title"
                           class="edit-form-label">
                        Title <span class="required-mark">*</span>
                    </label>

                    <input type="text"
                           id="Title"
                           name="Title"
                           class="edit-form-input"
                           placeholder="Enter book title"
                           value="@Model.Title"
                           required />

                </div>


                <!-- Author -->

                <div class="edit-form-group">

                    <label for="Author"
                           class="edit-form-label">
                        Author <span class="required-mark">*</span>
                    </label>

                    <input type="text"
                           id="Author"
                           name="Author"
                           class="edit-form-input"
                           placeholder="Enter author name"
                           value="@Model.Author"
                           required />

                </div>


                <!-- Category -->

                <div class="edit-form-group">

                    <label for="Category"
                           class="edit-form-label">
                        Category
                    </label>

                    <input type="text"
                           id="Category"
                           name="Category"
                           class="edit-form-input"
                           placeholder="e.g. Programming, Science, Fiction"
                           value="@Model.Category" />

                </div>


                <!-- Total Quantity -->

                <div class="edit-form-group">

                    <label for="TotalQty"
                           class="edit-form-label">
                        Total Quantity <span class="required-mark">*</span>
                    </label>

                    <input type="number"
                           id="TotalQty"
                           name="TotalQty"
                           class="edit-form-input"
                           value="@Model.TotalQty"
                           min="@issuedQuantity"
                           required />

                    <span class="edit-form-help">
                        Total quantity cannot be lower than the number of currently issued copies.
                    </span>

                </div>


                <!-- Currently Issued -->

                <div class="issued-info">

                    <span class="issued-info-label">
                        Currently Issued
                    </span>

                    <span class="issued-info-value">
                        @issuedQuantity
                    </span>

                </div>


                <!-- Actions -->

                <div class="edit-form-actions">

                    <button type="submit"
                            class="save-book-btn">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="cancel-edit-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    }
    else
    {
        <!-- =====================================
             BOOK NOT FOUND
             ===================================== -->

        <div class="edit-book-card">

            <div class="edit-book-error">
                The requested book could not be found.
            </div>

            <div class="edit-form-actions">

                <a asp-action="Index"
                   class="cancel-edit-btn">
                    Back to Books
                </a>

            </div>

        </div>
    }

</div>