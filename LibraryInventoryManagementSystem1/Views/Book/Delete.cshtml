@model LibraryInventoryManagementSystem1.Models.Book

@{
    ViewData["Title"] = "Delete Book";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-center">
    <div class="card border-0 shadow-sm" style="width: 100%; max-width: 520px;">
        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-danger-subtle text-danger-emphasis rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px;font-size:1.4rem;">
                    ⚠️
                </div>
                <div>
                    <h2 class="h5 fw-bold mb-1">Delete Book</h2>
                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                </div>
            </div>

            <div class="alert alert-warning d-flex align-items-start gap-2 small mb-4" role="alert">
                <span>❗</span>
                <span>Are you sure you want to delete this book? Please review the details below before confirming.</span>
            </div>

            <table class="table table-sm table-borderless mb-4">
                <tbody>
                    <tr>
                        <th class="text-muted fw-semibold" style="width: 35%;">Book Id</th>
                        <td class="fw-semibold">#@Model.BookId</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold">Title</th>
                        <td>@Model.Title</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold">Author</th>
                        <td>@Model.Author</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold">Category</th>
                        <td>
                            <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle text-capitalize">
                                @(Model.Category ?? "Uncategorized")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold">Total Qty</th>
                        <td>@Model.TotalQty</td>
                    </tr>
                </tbody>
            </table>

            <form method="post" asp-action="Delete" asp-route-id="@Model.BookId" class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4">🗑️ Delete</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
            </form>

        </div>
    </div>
</div>