@model LibraryInventoryManagementSystem1.Models.User

@{
    ViewData["Title"] = "Delete Librarian";
    Layout = "_AdminLayout";
}

<div class="dashboard-hero" style="margin-bottom:20px;">
    <h2>Delete Librarian</h2>
</div>

<p>Are you sure you want to delete this librarian?</p>

<table style="margin-bottom:20px;">
    <tr><td style="padding:4px 12px 4px 0;"><strong>Username</strong></td><td>@Model.Username</td></tr>
    <tr><td style="padding:4px 12px 4px 0;"><strong>Email</strong></td><td>@Model.Email</td></tr>
</table>

<form method="post" asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" style="background:#c0392b; color:white; padding:8px 16px; border:none;">Confirm Delete</button>
    <a asp-action="Index" style="margin-left:10px;">Cancel</a>
</form>