@model List<LibraryInventoryManagementSystem1.Models.BookIssue>?

@{
    ViewData["Title"] = "Issued Books";
    Layout = "_AdminLayout";

    var issues = Model ?? new List<LibraryInventoryManagementSystem1.Models.BookIssue>();
    var searchValue = Context.Request.Query["search"].ToString();
    var issuedCount = ViewBag.IssuedCount ?? issues.Count;
}

<style>
    /* =========================================
           ISSUED BOOKS PAGE
           ========================================= */

    .issued-books-page {
        width: 100%;
        padding: 0;
        box-sizing: border-box;
    }

    /* =========================================
           HERO SECTION
           ========================================= */

    .issued-books-hero {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        box-sizing: border-box;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
    }

    .issued-books-hero-content h2 {
        margin: 0;
        color: #111827;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.3;
    }

    .issued-books-hero-content p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.5;
    }

    .issued-count {
        flex-shrink: 0;
        padding: 10px 16px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 10px;
        color: #c2410c;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================
           TOOLBAR
           ========================================= */

    .issued-books-toolbar {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .issued-search-form {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .issued-search-input {
        flex: 1;
        min-width: 200px;
        height: 44px;
        padding: 0 15px;
        box-sizing: border-box;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        outline: none;
        background: #ffffff;
        color: #111827;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .issued-search-input::placeholder {
            color: #9ca3af;
        }

        .issued-search-input:hover {
            border-color: #9ca3af;
        }

        .issued-search-input:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }

    /* =========================================
           BUTTONS
           ========================================= */

    .btn-issued-search {
        height: 44px;
        padding: 0 22px;
        border: none;
        border-radius: 9px;
        background: #4f46e5;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .btn-issued-search:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

    .btn-issue-book {
        height: 44px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #111827;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .btn-issue-book:hover {
            background: #1f2937;
            color: #ffffff;
            transform: translateY(-1px);
        }

    /* =========================================
           TABLE CARD
           ========================================= */

    .issued-table-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
        box-sizing: border-box;
    }

    /* =========================================
           TABLE HEADER
           ========================================= */

    .issued-table-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

        .issued-table-header h3 {
            margin: 0;
            color: #111827;
            font-size: 18px;
            font-weight: 700;
        }

        .issued-table-header span {
            color: #6b7280;
            font-size: 13px;
        }

    /* =========================================
           TABLE WRAPPER
           ========================================= */

    .issued-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    /* =========================================
           TABLE
           ========================================= */

    .issued-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        border-spacing: 0;
    }

        .issued-table thead {
            background: #f8fafc;
        }

        .issued-table th {
            padding: 15px 20px;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .issued-table td {
            padding: 17px 20px;
            color: #4b5563;
            border-bottom: 1px solid #eef0f3;
            text-align: left;
            font-size: 14px;
            vertical-align: middle;
        }

            /* =========================================
           COLUMN ALIGNMENT
           ========================================= */

            .issued-table th:nth-child(1),
            .issued-table td:nth-child(1) {
                width: 90px;
                text-align: center;
            }

            .issued-table th:nth-child(2),
            .issued-table td:nth-child(2) {
                width: 25%;
            }

            .issued-table th:nth-child(3),
            .issued-table td:nth-child(3) {
                width: 23%;
            }

            .issued-table th:nth-child(4),
            .issued-table td:nth-child(4) {
                width: 130px;
            }

            .issued-table th:nth-child(5),
            .issued-table td:nth-child(5) {
                width: 130px;
            }

            .issued-table th:nth-child(6),
            .issued-table td:nth-child(6) {
                width: 110px;
                text-align: center;
            }

        /* =========================================
           TABLE ROW
           ========================================= */

        .issued-table tbody tr {
            background: #ffffff;
            transition: background-color 0.2s ease;
        }

            .issued-table tbody tr:hover {
                background: #f8faff;
            }

            .issued-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* =========================================
           ISSUE ID
           ========================================= */

    .issue-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 30px;
        padding: 0 9px;
        box-sizing: border-box;
        border-radius: 7px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
    }

    /* =========================================
           BOOK / STUDENT INFORMATION
           ========================================= */

    .issued-book-title,
    .issued-student-name {
        display: block;
        margin-bottom: 4px;
        color: #111827;
        font-weight: 600;
    }

    .issued-book-id,
    .issued-student-id {
        color: #9ca3af;
        font-size: 12px;
    }

    /* =========================================
           DATE
           ========================================= */

    .issue-date,
    .due-date {
        color: #4b5563;
        font-size: 13px;
        white-space: nowrap;
    }

    .due-date {
        color: #b45309;
        font-weight: 600;
    }

    /* =========================================
           RETURN BUTTON
           ========================================= */

    .btn-return {
        min-width: 78px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fef2f2;
        color: #dc2626;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-return:hover {
            background: #dc2626;
            border-color: #dc2626;
            color: #ffffff;
            transform: translateY(-1px);
        }

    /* =========================================
           EMPTY STATE
           ========================================= */

    .issued-empty-state {
        padding: 55px 20px !important;
        text-align: center !important;
        color: #6b7280 !important;
    }

    .issued-empty-icon {
        display: block;
        margin-bottom: 10px;
        font-size: 36px;
    }

    .issued-empty-state strong {
        display: block;
        margin-bottom: 5px;
        color: #374151;
        font-size: 15px;
        font-weight: 600;
    }

    .issued-empty-state span:last-child {
        color: #9ca3af;
        font-size: 13px;
    }

    /* =========================================
           RESPONSIVE DESIGN
           IMPORTANT:
           Use @@media inside Razor .cshtml files.
           ========================================= */

    @@media (max-width: 900px) {

        .issued-search-form {
            flex-wrap: wrap;
        }

        .issued-search-input {
            width: 100%;
            flex-basis: 100%;
        }
    }

    @@media (max-width: 768px) {

        .issued-books-hero {
            padding: 22px;
            flex-direction: column;
            align-items: flex-start;
        }

        .issued-books-hero-content h2 {
            font-size: 24px;
        }

        .issued-count {
            align-self: flex-start;
        }

        .issued-books-toolbar {
            padding: 15px;
        }

        .issued-search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .issued-search-input,
        .btn-issued-search,
        .btn-issue-book {
            width: 100%;
        }

        .issued-table-header {
            padding: 17px;
        }

        .issued-table th,
        .issued-table td {
            padding: 14px 16px;
        }
    }

    @@media (max-width: 480px) {

        .issued-books-hero {
            padding: 20px;
        }

        .issued-books-hero-content h2 {
            font-size: 21px;
        }

        .issued-books-hero-content p {
            font-size: 13px;
        }

        .issued-table-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>


<div class="issued-books-page">

    <!-- =====================================
         PAGE HEADER
         ===================================== -->

    <div class="issued-books-hero">

        <div class="issued-books-hero-content">

            <h2>
                Issued Books
            </h2>

            <p>
                View and manage books currently issued to students.
            </p>

        </div>

        <div class="issued-count">
            @issuedCount @(issuedCount == 1 ? "Book" : "Books") Issued
        </div>

    </div>


    <!-- =====================================
         SEARCH & ACTION TOOLBAR
         ===================================== -->

    <div class="issued-books-toolbar">

        <form method="get"
              asp-action="Index"
              class="issued-search-form">

            <input type="text"
                   name="search"
                   class="issued-search-input"
                   placeholder="Search by Book ID, Student ID, or Student Name..."
                   value="@searchValue" />

            <button type="submit"
                    class="btn-issued-search">
                Search
            </button>

            <a asp-action="Issue"
               class="btn-issue-book">
                + Issue a Book
            </a>

        </form>

    </div>


    <!-- =====================================
         ISSUED BOOKS TABLE
         ===================================== -->

    <div class="issued-table-card">

        <div class="issued-table-header">

            <h3>
                Issued Book Records
            </h3>

            <span>
                @issues.Count @(issues.Count == 1 ? "record" : "records")
            </span>

        </div>


        <div class="issued-table-wrapper">

            <table class="issued-table">

                <thead>

                    <tr>

                        <th>
                            Issue ID
                        </th>

                        <th>
                            Book
                        </th>

                        <th>
                            Student
                        </th>

                        <th>
                            Issue Date
                        </th>

                        <th>
                            Due Date
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (issues.Count > 0)
                    {
                        foreach (var issue in issues)
                        {
                            <tr>

                                <!-- Issue ID -->
                                <td>
                                    <span class="issue-id">
                                        #@issue.IssueId
                                    </span>
                                </td>


                                <!-- Book -->
                                <td>

                                    <span class="issued-book-title">
                                        @(issue.Book?.Title ?? "N/A")
                                    </span>

                                    <span class="issued-book-id">
                                        Book ID: #@issue.BookId
                                    </span>

                                </td>


                                <!-- Student -->
                                <td>

                                    <span class="issued-student-name">
                                        @(issue.Student?.Name ?? "N/A")
                                    </span>

                                    <span class="issued-student-id">
                                        Student ID: #@issue.StudentId
                                    </span>

                                </td>


                                <!-- Issue Date -->
                                <td>
                                    <span class="issue-date">
                                        @issue.IssueDate.ToString("dd-MMM-yyyy")
                                    </span>
                                </td>


                                <!-- Due Date -->
                                <td>
                                    <span class="due-date">
                                        @issue.DueDate.ToString("dd-MMM-yyyy")
                                    </span>
                                </td>


                                <!-- Return -->
                                <td>

                                    <form method="post"
                                          asp-action="Return"
                                          asp-route-id="@issue.IssueId">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-return">
                                            Return
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="issued-empty-state">

                                <span class="issued-empty-icon">
                                    📚
                                </span>

                                <strong>
                                    No issued books found
                                </strong>

                                <span>
                                    There are currently no books issued or no matching records were found.
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>