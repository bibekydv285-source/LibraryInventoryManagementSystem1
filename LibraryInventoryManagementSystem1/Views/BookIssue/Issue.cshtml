@model LibraryInventoryManagementSystem1.Dto.IssueBookDto

@{
    ViewData["Title"] = "Issue a Book";
    Layout = "_AdminLayout";
}

<div class="dashboard-hero" style="margin-bottom:20px;">
    <h2>Issue a Book</h2>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <p style="color:red;">@ViewBag.ErrorMessage</p>
}

<form method="post" asp-action="Issue" style="max-width:500px;">
    <div style="margin-bottom:15px;">
        <label>Book</label>
        <select name="BookId" style="width:100%; padding:8px;" required>
            <option value="">-- Select Book --</option>
            @foreach (var book in (List<LibraryInventoryManagementSystem1.Models.Book>)ViewBag.Books)
            {
                <option value="@book.BookId">@book.Title (Available: @book.AvailableQty)</option>
            }
        </select>
    </div>

    <div style="margin-bottom:15px;">
        <label>Student</label>
        <select name="StudentId" style="width:100%; padding:8px;" required>
            <option value="">-- Select Student --</option>
            @foreach (var student in (List<LibraryInventoryManagementSystem1.Models.Student>)ViewBag.Students)
            {
                <option value="@student.Id">@student.Name</option>
            }
        </select>
    </div>

    <div style="margin-bottom:15px;">
        <label>Due Date</label>
        <input type="date" name="DueDate" style="width:100%; padding:8px;" required />
    </div>

    <button type="submit">Issue Book</button>
    <a href="@Url.Action("Index")" style="margin-left:10px;">Cancel</a>
</form>